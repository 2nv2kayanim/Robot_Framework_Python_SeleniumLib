# Local mock mode is the default. Leave PORTAL_URL empty to start the local portal.
PORTAL_URL=
BROWSER=chrome
HEADLESS=true
CI=false
WINDOW_SIZE=1440x1000
TIMEOUT=10

# These credentials are for the local mock only. Set real test credentials in the
# environment when PORTAL_URL points at a disposable external test environment.
PORTAL_USERNAME=member@example.test
PORTAL_PASSWORD=MockBenefits!2026
